# ==============================================================================
# ÉVASION SOLEIL - CONFIGURATION DES ENVIRONNEMENTS & LOGINS COURRIELS
# ==============================================================================

# Clé API Google Gemini utilisée par Martine V.
GEMINI_API_KEY=""

# URL publique de l'application
APP_URL=""

# Port d'écoute pour l'hébergement Pterodactyl / cPanel (1031)
PORT=1031
SERVER_PORT=1031

# ==============================================================================
# BASE DE DONNÉES MYSQL (Pterodactyl / cPanel / MariaDB)
# ==============================================================================
MYSQL_HOST="127.0.0.1"
MYSQL_PORT=3306
MYSQL_USER="root"
MYSQL_PASSWORD=""
MYSQL_DATABASE="evasion_soleil"

# ==============================================================================
# DESTINATAIRE PRINCIPAL DE L'AGENCE (REÇOIT TOUTES LES ALERTES & DEMANDES)
# ==============================================================================
# Ce courriel reçoit les alertes immédiates de devis et les demandes de rappel client
NOTIFICATION_EMAIL="info@evasionsoleil.com"

# ==============================================================================
# 1. ACCÈS EMAIL DE MARTINE V. (martine@evasionsoleil.com)
# Utilisé pour envoyer les transcriptions de clavardage et les demandes de rappel
# ==============================================================================
MARTINE_EMAIL="martine@evasionsoleil.com"
MARTINE_FROM_NAME="Martine V. - Voyages Évasion Soleil"
MARTINE_SMTP_HOST="smtp.evasionsoleil.com"
MARTINE_SMTP_PORT=587
MARTINE_SMTP_USER="martine@evasionsoleil.com"
MARTINE_SMTP_PASS=""
MARTINE_SMTP_SECURE=false

# ==============================================================================
# 2. ACCÈS EMAIL NE PAS RÉPONDRE (ne_pas_repondre@evasionsoleil.com)
# Utilisé pour envoyer les accusés de réception officiels des demandes de devis
# ==============================================================================
NOREPLY_EMAIL="ne_pas_repondre@evasionsoleil.com"
NOREPLY_FROM_NAME="Voyages Évasion Soleil"
NOREPLY_SMTP_HOST="smtp.evasionsoleil.com"
NOREPLY_SMTP_PORT=587
NOREPLY_SMTP_USER="ne_pas_repondre@evasionsoleil.com"
NOREPLY_SMTP_PASS=""
NOREPLY_SMTP_SECURE=false

# ==============================================================================
# 3. SERVEUR SMTP GLOBAL (Optionnel - Utilisé en repli si Martine ou NoReply ne sont pas définis)
# ==============================================================================
SMTP_HOST="smtp.evasionsoleil.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE=false
